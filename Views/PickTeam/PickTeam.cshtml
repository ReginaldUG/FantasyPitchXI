@{
    ViewData["Title"] = "Pick Team Page";
}
@model FantasyPitchXI.ViewModels.PickTeamViewModel

<div>
    <h1>@Model.TeamName</h1>
    <h1>WORK IN PROGRESS</h1>
    <br/>

    @if (TempData["Error"] != null)
    {
        <p style="color:red;">@TempData["Error"]</p>
    }

    <h3 id="xiCount">Starting XI: 0 / 11</h3>
    <h3 id="benchCount">Bench: 0 / 4</h3>

    <br/>
    
    <form asp-action="SaveTeamXI" method="post" id="pickTeamForm">
        <input type="hidden" name="TeamId" value="@Model.TeamId"/>

        <div id="hiddenInputs"></div>

        <div style="display:flex; gap:50px; align-items:center;">
            <!--LEFT SIDE-->
            <div>
                <h2>Current Squad</h2>
                <!--Squad filters-->
                <div class="filters">
                    <label>
                        <input type="radio" name="positionFilter" value="All" checked onchange="filterAvailablePlayers(this.value)">
                        All
                    </label>
                    <label>
                        <input type="radio" name="positionFilter" value="Goalkeeper" onchange="filterAvailablePlayers(this.value)">
                        GK
                    </label>
                    <label>
                        <input type="radio" name="positionFilter" value="Defender" onchange="filterAvailablePlayers(this.value)">
                        DEF
                    </label>
                    <label>
                        <input type="radio" name="positionFilter" value="Midfielder" onchange="filterAvailablePlayers(this.value)">
                        MID
                    </label>
                    <label>
                        <input type="radio" name="positionFilter" value="Striker" onchange="filterAvailablePlayers(this.value)">
                        STR
                    </label>
                </div>

                <!--Squad table-->
                <div class="player-table-container">
                    <table border="1" cellpadding="8" id="availableTable">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Position</th>
                                <th>Club</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="availableBody">
                            @foreach (var player in Model.Squad.OrderBy(p=>p.Position))
                                {
                                    <tr data-id="@player.Id"
                                        data-name="@player.Name"
                                        data-position="@player.Position"
                                        data-club="@player.Club.Name"
                                        >

                                        <td>@player.Name</td>
                                        <td>@player.Position</td>
                                        <td>@player.Club.Name</td>
                                        <td>
                                            <button type="button" onclick="addToXI(this)">
                                                Add to XI
                                            </button>
                                            <button type="button" onclick="addToBench(this)">
                                                Add to Bench
                                            </button>
                                        </td>

                                    </tr>
                                }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!--Right side-->
            <div>
                <!--Starting XI-->
                <div>
                    <h2>Starting XI</h2>
                    <div class="player-table-container-small">
                        <table border="1" cellpadding="8">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Position</th>
                                    <th>C</th>
                                    <th>VC</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>

                            <tbody id="startingBody"></tbody>
                            @if (@Model.Starting.Any())
                            {
                                
                            }
                        </table>
                    </div>
                </div>
                <!--BENCH table-->
                <div>
                    <h2>Bench</h2>
                    <div class="player-table-container-small">
                        <table border="1" cellpadding="8">
                            <thead>
                                <tr>
                                    <th>Order</th>
                                    <th>Name</th>
                                    <th>Position</th>
                                    <th>Move</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>

                            <tbody id="benchBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <br/>
        <br/>
        
        <button type="submit"> Save Team</button>
    </form>
</div>

<style>
    .player-table-container{
        height: 500px;
        overflow: auto;
        border: 1px solid black;
    }
    .player-table-container-small{
        height: 250px;
        overflow: auto;
        border: 1px solid black;
    }
    table{
        width: 100%;
        border-collapse: collapse
    }
    th{
        position: sticky;
        top:0;
        background-color: white;
    }
    tr:hover{
        background-color:#f2f2f2;
    }
    .filters{
        margin-bottom: 10px;
    }
</style>

<script>
    // Map the starting LineupPlayerDto items into flat, safe client-side objects
    let startingPlayers = @Html.Raw(Json.Serialize(Model.Starting.Select(item => new {
        isCaptain = item.IsCaptain,
        isViceCaptain = item.IsViceCaptain,
        player = new {
            id = item.Player.Id,
            name = item.Player.Name,
            position = item.Player.Position.ToString(),
            club = item.Player.Club?.Name ?? ""
        }
    }))) || [];

    // Map the bench Player items into flat, safe client-side objects
    let benchPlayers = @Html.Raw(Json.Serialize(Model.Bench.Select(player => new {
        id = player.Id,
        name = player.Name,
        position = player.Position.ToString(),
        club = player.Club?.Name ?? ""
    }))) || [];
    
    const currentCaptain = startingPlayers.find(item => item.isCaptain === true);
    const currentVice = startingPlayers.find(item => item.isViceCaptain === true);

    let captainId = currentCaptain ? currentCaptain.player.id : null;
    let viceCaptainId = currentVice ? currentVice.player.id : null;

    document.getElementById("pickTeamForm").addEventListener("submit", function(e){
        if(startingPlayers.length !== 11){
            alert("Starting XI must contain exactly 11 players");
            e.preventDefault();
            return;
        }
        if(benchPlayers.length > 4){
            alert("Bench cannot contain more than 4 players");
            e.preventDefault();
            return;
        }
        if(captainId === null){
            alert("Select a Captain");
            e.preventDefault();
            return;
        }
        if(viceCaptainId === null){
            alert("Select a Vice Captain");
            e.preventDefault();
            return;
        }
    });

    //ON PAGE LOAD
    renderStartingXI();
    renderBench();
    updateCounts();
    updateHiddenInputs();

    function addToXI(button){
        if(startingPlayers.length >= 11){
            alert("Starting XI already full");
            return;
        }
        const row = button.closest("tr");
        const player = extractPlayer(row);

        //wrapping in DTO format to match the right starting table object format
        startingPlayers.push({
            player: player,
            isCaptain: false,
            isViceCaptain: false
        });
        row.remove();
        renderStartingXI();
        updateCounts();
        updateHiddenInputs();
    }

    function addToBench(button){
        if(benchPlayers.length >= 4){
            alert("Bench already full");
            return;
        }
        const row = button.closest("tr");
        const player = extractPlayer(row);

        if(player.position === "Goalkeeper"){
            let benchGk = benchPlayers.filter(p=>p.position === "Goalkeeper").length;

            if(benchGk >= 1){
                alert("Bench can only contain 1 Goalkeeper");
                return;
            }
        }
        benchPlayers.push(player);

        row.remove();
        renderBench();
        updateCounts();
        updateHiddenInputs();
    }

    function removeFromXI(playerId){
        const item = startingPlayers.find(p=>p.player.id === playerId);
        if(!item) return;

        startingPlayers = startingPlayers.filter(p=>p.player.id !== playerId);

        if(captainId === playerId){
            captainId = null;
        }

        if(viceCaptainId === playerId){
            viceCaptainId = null;
        }

        addBackToAvailablePlayers(item.player);
        renderStartingXI();
        updateCounts();
        updateHiddenInputs();
    }

    function removeFromBench(playerId){
        const player = benchPlayers.find(p=>p.id===playerId);
        benchPlayers = benchPlayers.filter(p=>p.id !== playerId);

        addBackToAvailablePlayers(player);
        renderBench();
        updateCounts();
        updateHiddenInputs();
    }

    function renderStartingXI() {
        const body = document.getElementById("startingBody");
        body.innerHTML = "";

        startingPlayers.forEach(item => {
            const player = item.player;

            let captainChecked = captainId === player.id ? "checked" : "";
            let viceChecked = viceCaptainId === player.id ? "checked" : "";

            body.innerHTML += `
                <tr>
                    <td>${player.name}</td>
                    <td>${player.position}</td>

                    <td>
                        <input
                            type="radio"
                            name="captainRadio"
                            value="${player.id}"
                            ${captainChecked}
                            onchange="setCaptain(${player.id})"
                        />
                    </td>

                    <td>
                        <input
                            type="radio"
                            name="viceCaptainRadio"
                            value="${player.id}"
                            ${viceChecked}
                            onchange="setViceCaptain(${player.id})"
                        />
                    </td>

                    <td>
                        <button type="button"
                            onclick="removeFromXI(${player.id})">
                            Remove
                        </button>
                    </td>
                </tr>
            `;
        });
    }


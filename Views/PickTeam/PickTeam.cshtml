    function renderBench(){
        const body = document.getElementById("benchBody");
        body.innerHTML = "";
        benchPlayers.forEach((player,index)=>{
            body.innerHTML += `
                <tr>
                    <td>${index + 1}</td>
                    <td>${player.name}</td>
                    <td>${player.position}</td>
                    <td>
                        ${index > 0
                            ? `<button type="button"
                                onclick="moveBenchUp(${index})">↑</button>`
                            : ""
                        }

                        ${index < benchPlayers.length - 1
                            ? `<button type="button"
                                onclick="moveBenchDown(${index})">↓</button>`
                            : ""
                        }
                    </td>
                    <td>
                        <button type="button" onclick="removeFromBench(${player.id})">Remove</button>
                    </td>
                </tr>
            `;
        });
    }

    function moveBenchUp(index){
        if(index===0) return;

        [benchPlayers[index-1], benchPlayers[index]] = [benchPlayers[index], benchPlayers[index - 1]];

        renderBench();
        updateHiddenInputs();
    }

    function moveBenchDown(index){
        if(index === benchPlayers.length - 1){
            return;
        }

        [benchPlayers[index + 1], benchPlayers[index]] = [benchPlayers[index], benchPlayers[index + 1]];

        renderBench();
        updateHiddenInputs();
    }

    function addBackToAvailablePlayers(player){
        const body = document.getElementById("availableBody");
        body.innerHTML += `
            <tr data-id="${player.id}"
                data-name="${player.name}"
                data-position="${player.position}"
                data-club="${player.club}"
                >
                <td>${player.name}</td>
                <td>${player.position}</td>
                <td>${player.club || ''}</td>
                <td>
                    <button type="button" onclick="addToXI(this)">Add to XI</button>
                    <button type="button" onclick="addToBench(this)">Add to Bench</button>
                </td>
            </tr>
        `;
    }

    function extractPlayer(row){
        return{
            id: parseInt(row.dataset.id),
            name: row.dataset.name,
            position: row.dataset.position,
            club: row.dataset.club
        };
    }

    function filterAvailablePlayers(position){
        const rows = document.querySelectorAll("#availableTable tbody tr");
        rows.forEach(row=>{
            if(position === "All"){
                row.style.display = "";
                return;
            }
            if(row.dataset.position===position){
                row.style.display = "";
            }
            else
            {
                row.style.display = "none";

            }
        });
    }

    function updateCounts(){
        document.getElementById("xiCount").innerText = "Starting XI: " + startingPlayers.length + " / 11";
        document.getElementById("benchCount").innerText = "Bench: "+benchPlayers.length+" / 4";
    }

    function setCaptain(playerId){
        if(viceCaptainId === playerId){
            alert("Captain and Vice Captain cannot be the same player");
            renderStartingXI();
            return;
        }
        captainId = playerId;
        updateHiddenInputs();
    }

    function setViceCaptain(playerId){
        if(captainId === playerId){
            alert("Captain and Vice Captain cannot be the same player");
            renderStartingXI();
            return;
        }
        viceCaptainId = playerId;
        updateHiddenInputs();
    }

    function updateHiddenInputs(){
        const container = document.getElementById("hiddenInputs");
        container.innerHTML = "";

        startingPlayers.forEach(item=>{
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "StartingTeamPlayerIDs";
            input.value = item.player.id;
            container.appendChild(input);
        });

        benchPlayers.forEach(player=>{
            const input = document.createElement("input");
            input.type = "hidden";
            input.name="BenchPlayerIDs";
            input.value = player.id;
            container.appendChild(input);
        });

        if(captainId !== null){
            const captainInput = document.createElement("input");
            captainInput.type = "hidden";
            captainInput.name = "CaptainID";
            captainInput.value = captainId;
            container.appendChild(captainInput);
        }

        if(viceCaptainId !== null){
            const viceInput = document.createElement("input");
            viceInput.type = "hidden";
            viceInput.name = "ViceCaptainID";
            viceInput.value = viceCaptainId;
            container.appendChild(viceInput);
        }
    }

</script>